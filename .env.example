# PII-Safe configuration. Copy to .env and fill in what you use:
#     cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real keys, tokens or passwords.
#
# Everything is optional: with nothing set, PII-Safe uses SQLite and a local
# master key in ~/.piisafe (fine for a laptop or a single host).
#
# docker compose reads this file automatically. For the CLI / SDK, load it into
# your shell first:   set -a && . ./.env && set +a

# ----------------------------------------------------------------- state
# Where the SQLite DB, local master key and file outputs live.
# PIISAFE_HOME=~/.piisafe

# ----------------------------------------------------------------- database
# Leave unset for SQLite. Set for PostgreSQL (shared state for several API
# replicas, CLI hosts and MCP servers). Needs: pip install 'piisafe[postgres]'
# PIISAFE_DATABASE_URL=postgresql://piisafe:CHANGE_ME@localhost:5432/piisafe

# Used by docker-compose.yml to create the bundled Postgres container.
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# ----------------------------------------------------------------- master key
# Which provider holds the master key: local | env | aws-kms | vault-transit
# (default: env if PIISAFE_MASTER_KEY is set, else local file).
# PIISAFE_KEY_PROVIDER=local

# --- provider "env": the key itself, from your secrets manager.
# Generate: python -c "from piisafe.crypto import generate_key; print(generate_key())"
# PIISAFE_MASTER_KEY=

# --- provider "aws-kms" (pip install 'piisafe[aws]'). Needs kms:Encrypt + kms:Decrypt on the key.
# PIISAFE_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AWS_REGION=eu-west-1
# Credentials: prefer an instance / task / IRSA role. Otherwise a profile ...
# AWS_PROFILE=piisafe
# ... or static keys (least preferred):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- provider "vault-transit" (HashiCorp Vault Transit secrets engine).
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=
# VAULT_NAMESPACE=
# VAULT_CACERT=/etc/ssl/vault-ca.pem
# PIISAFE_VAULT_KEY=piisafe
# PIISAFE_VAULT_MOUNT=transit

# ----------------------------------------------------------------- your LLM provider
# PII-Safe never calls an LLM itself. These are only for YOUR agent code
# (LangChain / LangGraph examples), read by the provider SDKs directly.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
